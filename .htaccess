RewriteEngine On

# Enforce a single canonical host (non-www)
RewriteCond %{HTTP_HOST} ^www\.pincodelocator\.co\.in$ [NC]
RewriteRule ^ https://pincodelocator.co.in%{REQUEST_URI} [L,R=301,NE]

# Dynamic ads.txt from environment-backed config
RewriteRule ^ads\.txt$ ads-txt.php [L,QSA]

# Allow existing files
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Allow directories
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Blog routes
RewriteRule ^blog/?$ index.php?route=blog [L,QSA]
RewriteRule ^blog/([a-zA-Z0-9-]+)/?$ index.php [L,QSA]

# ROUTING SYSTEM
RewriteRule ^([a-zA-Z0-9-]+)/?$ index.php?route=$1 [L,QSA]

# Sitemap
RewriteRule ^sitemap.xml$ sitemap_index.php [L]

ErrorDocument 404 /404.php
