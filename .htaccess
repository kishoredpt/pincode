RewriteEngine On

# Ensure clean URLs are not treated as content-negotiated files.
Options -MultiViews

# Canonical host (www -> non-www) for consistent indexing.
RewriteCond %{HTTP_HOST} ^www\.pincodelocator\.co\.in$ [NC]
RewriteRule ^ https://pincodelocator.co.in%{REQUEST_URI} [R=301,L]

# Blog routes
RewriteRule ^blog/?$ blog.php [L,QSA]
RewriteRule ^blog/([a-zA-Z0-9-]+)/?$ blog-post.php?slug=$1 [L,QSA]

# Sitemap
RewriteRule ^sitemap\.xml$ sitemap_index.php [L]

# Route all non-file/non-directory requests through index.php.
# This works for URLs like /telangana and /507165.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [L,QSA]

# Apache fallback for hosts where RewriteRule processing is constrained.
FallbackResource /index.php

ErrorDocument 404 /404.php
